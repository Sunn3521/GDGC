# CrisisMate Environment Configuration
# Copy this file to .env or set environment variables in your server environment.
# NEVER commit real API keys to git repository.

# Server-Side Gemini API Key (Secret - DO NOT prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Client Configuration (Public Client Credentials)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
