# CrisisMate Environment Configuration
# Copy this file to .env or set environment variables in your server environment.
# NEVER commit real API keys to git repository.

# Server-Side Gemini API Key (Secret - DO NOT prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Development key override for local testing only
VITE_GEMINI_API_KEY=
